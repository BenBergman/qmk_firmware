{
    "manufacturer": "Ben Bergman",
    "keyboard_name": "winnitron",
    "maintainer": "Ben Bergman",
    "development_board": "promicro_rp2040",
    "features": {
        "console": true,
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "rgb_matrix": true,
        "nkro": true
    },
    "eeprom_WARNING": "flashing does not clear EEPROM, so that needs to be done for new default settings to be used",
    "eeprom": {
        "driver": "transient"
    },
    "matrix_pins": {
        "direct": [
            [ "GP2", "GP3", "GP4", "GP5", "GP6", "GP7" ],
            [ "GP1" ],
            [ "GP20", "GP22", "GP26", "GP27", "GP28", "GP29" ],
            [ "GP0" ],
            [ "GP25" ]
        ]
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                { "label": "p1 up",         "matrix": [ 0, 0 ], "x": 0, "y": 0 },
                { "label": "p1 left",       "matrix": [ 0, 1 ], "x": 0, "y": 1 },
                { "label": "p1 down",       "matrix": [ 0, 2 ], "x": 0, "y": 2 },
                { "label": "p1 right",      "matrix": [ 0, 3 ], "x": 0, "y": 3 },
                { "label": "p1 b1",         "matrix": [ 0, 4 ], "x": 0, "y": 4 },
                { "label": "p1 b1",         "matrix": [ 0, 5 ], "x": 0, "y": 5 },
                { "label": "ESC",           "matrix": [ 1, 0 ], "x": 1, "y": 0 },
                { "label": "p2 up",         "matrix": [ 2, 0 ], "x": 2, "y": 0 },
                { "label": "p2 left",       "matrix": [ 2, 1 ], "x": 2, "y": 1 },
                { "label": "p2 down",       "matrix": [ 2, 2 ], "x": 2, "y": 2 },
                { "label": "p2 right",      "matrix": [ 2, 3 ], "x": 2, "y": 3 },
                { "label": "p2 b1",         "matrix": [ 2, 4 ], "x": 2, "y": 4 },
                { "label": "p2 b1",         "matrix": [ 2, 5 ], "x": 2, "y": 5 },
                { "label": "p12/34 toggle", "matrix": [ 3, 0 ], "x": 3, "y": 0 },
                { "label": "clear EEPROM",  "matrix": [ 4, 0 ], "x": 4, "y": 0 }
            ]
        }
    },
    "rgb_matrix": {
        "driver": "ws2812",
        "max_brightness": 255,
        "animations": {
            "alphas_mods": true,
            "cycle_left_right": true,
            "solid_reactive_simple": true
        },
        "default": {
            "on": true,
            "animation": "cycle_left_right",
            "hue": 125,
            "sat": 255,
            "val": 100,
            "speed": 40
        },
        "layout": [
            { "matrix": [ 0, 4 ], "x": 60, "y": 32, "flags": 4 },
            { "matrix": [ 0, 5 ], "x": 80, "y": 32, "flags": 4 },
            { "matrix": [ 1, 0 ], "x": 112, "y": 0, "flags": 4 },
            { "matrix": [ 2, 4 ], "x": 200, "y": 32, "flags": 4 },
            { "matrix": [ 2, 5 ], "x": 220, "y": 32, "flags": 4 },
            { "matrix": [ 3, 0 ], "x": 3, "y": 0, "flags": 8 },
            { "x": 112, "y": 32, "flags": 1 },
            { "x": 112, "y": 32, "flags": 2 }
        ]
    },
    "ws2812": {
        "pin": "GP11",
        "driver": "vendor"
    }
}
